import 'package:flutter/material.dart';

/// Show a single dish on the menu.
class CurryDish {
  const CurryDish({
    required this.name,
    required this.description,
    required this.price,
    required this.imagePath,
    required this.spiceLevel,
    this.isVegetarian = false,
  });

  final String name;
  final String description;
  final double price;
  final String imagePath;
  final int spiceLevel; // 0 - 3
  final bool isVegetarian;
}

const Map<String, List<CurryDish>> _menu = {
  'Curries': [
    CurryDish(
      name: 'Butter Chicken',
      description: 'Tender chicken in a creamy tomato and butter gravy.',
      price: 16.90,
      imagePath: 'assets/images/butter_chicken.jpg',
      spiceLevel: 1,
    ),
    CurryDish(
      name: 'Rendang Daging',
      description: 'Slow-cooked beef in coconut milk and fragrant spices.',
      price: 18.90,
      imagePath: 'assets/images/rendang.jpg',
      spiceLevel: 3,
    ),
    CurryDish(
      name: 'Dhal Tadka',
      description: 'Yellow lentils tempered with garlic, cumin and chilli.',
      price: 11.90,
      imagePath: 'assets/images/dhal.jpg',
      spiceLevel: 2,
      isVegetarian: true,
    ),
  ],
  'Breads & Rice': [
    CurryDish(
      name: 'Garlic Naan',
      description: 'Oven-baked flatbread brushed with garlic butter.',
      price: 4.50,
      imagePath: 'assets/images/naan.jpg',
      spiceLevel: 0,
      isVegetarian: true,
    ),
    CurryDish(
      name: 'Chicken Biryani',
      description: 'Basmati rice layered with spiced chicken and herbs.',
      price: 15.90,
      imagePath: 'assets/images/biryani.jpg',
      spiceLevel: 2,
    ),
  ],
  'Drinks & Desserts': [
    CurryDish(
      name: 'Mango Lassi',
